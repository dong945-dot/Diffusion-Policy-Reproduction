<mujoco model="openarm_bimanual_push_t_scene">
  <!-- 引入原本的双臂模型 -->
  <include file="openarm_bimanual.xml"/>

  <statistic center="0.35 0 0.25" extent="0.8" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-15"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- 天空盒与地面纹理 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <!-- 任务专属材质 -->
    <material name="table_mat" rgba="0.88 0.88 0.88 1.0" specular="0.1" shininess="0.2"/>
    <material name="tee_mat" rgba="0.2 0.45 0.9 1.0" specular="0.3" shininess="0.5"/>       <!-- T块: 蓝色实体 -->
    <material name="goal_mat" rgba="0.2 0.9 0.3 0.3" specular="0.0" shininess="0.0"/>      <!-- 目标区: 绿色半透明 -->
  </asset>

  <worldbody>
    <!-- 光照 -->
    <light pos="0.3 0 1.6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

   <!-- ==================== 工作台 (位置最舒适的 X=0.32) ==================== -->
    <body name="table" pos="0.32 0 0.09">
      <geom name="table_top" type="box" size="0.20 0.32 0.09" material="table_mat" friction="1.2 0.01 0.005"/>
    </body>

    <!-- ==================== 目标虚影 (彻底禁绝任何碰撞) ==================== -->
    <body name="goal_zone" pos="0.33 0 0.181">
      <geom name="goal_head" type="box" size="0.08 0.025 0.001" pos="0 0.04 0" 
            material="goal_mat" contype="0" conaffinity="0" group="1"/>
      <geom name="goal_stem" type="box" size="0.025 0.04 0.001" pos="0 -0.025 0" 
            material="goal_mat" contype="0" conaffinity="0" group="1"/>
    </body>

    <!-- ==================== 逼真物理特性的 3D T 块 ==================== -->
    <body name="tee_block" pos="0.28 0 0.20">
      <!-- 增加 damping 消除冰壶效应，不推绝不无故自滑 -->
      <joint name="tee_freejoint" type="free" damping="0.05" armature="0.01"/>
      <geom name="tee_head" type="box" size="0.08 0.025 0.015" pos="0 0.04 0" 
            material="tee_mat" mass="0.15" friction="1.2 0.02 0.01"/>
      <geom name="tee_stem" type="box" size="0.025 0.04 0.015" pos="0 -0.025 0" 
            material="tee_mat" mass="0.10" friction="1.2 0.02 0.01"/>
    </body>
    <!-- ==================== 摄像头配置 (Diffusion Policy 视觉输入) ==================== -->
    <!-- 1. 正上方俯视相机 (Push-T 经典输入视角) -->
    <camera name="top_cam" pos="0.42 0 0.85" euler="0 0 1.5708" fovy="55"/>

    <!-- 2. 第三人称斜向正视角 (覆盖机械臂全身和桌面操作区) -->
    <camera name="front_cam" pos="0.95 0 0.62" euler="0 0.65 1.5708" fovy="48"/>

    <!-- 3. 双臂后上方跟随视角 (观察末端对齐细节) -->
    <camera name="shoulder_cam" pos="-0.25 0 0.6" euler="0 0.85 -1.5708" fovy="55"/>
  </worldbody>
</mujoco>
