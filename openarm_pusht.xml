"""
openarm_pusht_env.py

OpenArm v2.0 单臂（右臂）Push-T 环境。
动作: 末端 (x, y) 平面目标 (m)。内部用阻尼最小二乘 IK 转右臂 7 关节角。
观测: T 形块位姿/速度 + 右末端 site 位置 + 目标位姿。
成功: T 形块与目标 (x,y) 误差 < pos_tol 且 yaw 误差 < yaw_tol。
"""

import os
import numpy as np
import mujoco


# ----------------------------------------------------------------------
# IK：右臂 7 关节，末端 site 到达 (x, y, z_fixed)
# ----------------------------------------------------------------------
class RightArmIK:
    def __init__(self, model, data, site_name="right_ee_control_point",
                 joint_names=None, z_fixed=0.06,
                 max_iter=50, tol=1e-4, damping=1e-3):
        self.model = model
        self.data = data
        self.site_id = model.site(site_name).id
        self.z_fixed = z_fixed
        self.max_iter = max_iter
        self.tol = tol
        self.damping = damping

        if joint_names is None:
            joint_names = [f"openarm_right_joint{i}" for i in range(1, 8)]
        self.jnt_ids = [model.joint(n).id for n in joint_names]
        self.qadr = np.array([model.jnt_qposadr[j] for j in self.jnt_ids])
        self.dadr = np.array([model.jnt_dofadr[j] for j in self.jnt_ids])
        self.jnt_range = np.array([model.jnt_range[j] for j in self.jnt_ids])

        self._jacp = np.zeros((3, model.nv))

    def solve(self, xy_target, q_init=None):
        """返回 7 个关节角。q_init 为 warm-start（可选）。"""
        if q_init is not None:
            self.data.qpos[self.qadr] = q_init

        target = np.array([xy_target[0], xy_target[1], self.z_fixed])
        for _ in range(self.max_iter):
            mujoco.mj_forward(self.model, self.data)
            cur = self.data.site_xpos[self.site_id]
            err = target - cur
            if np.linalg.norm(err) < self.tol:
                break

            self._jacp[:] = 0.0
            mujoco.mj_jacSite(self.model, self.data, self._jacp, None, self.site_id)
            J = self._jacp[:, self.dadr]                     # 3 x 7
            dq = J.T @ np.linalg.solve(
                J @ J.T + self.damping * np.eye(3), err)     # 7
            self.data.qpos[self.qadr] += dq
            np.clip(self.data.qpos[self.qadr],
                    self.jnt_range[:, 0], self.jnt_range[:, 1],
                    out=self.data.qpos[self.qadr])
        return self.data.qpos[self.qadr].copy()


# ----------------------------------------------------------------------
# 环境
# ----------------------------------------------------------------------
class OpenArmPushTEnv:
    def __init__(self, xml_path, frame_skip=10, z_fixed=0.06,
                 pos_tol=0.03, yaw_tol=0.15,
                 action_low=(0.10, -0.30), action_high=(0.50, 0.05)):
        self.model = mujoco.MjModel.from_xml_path(xml_path)
        self.data = mujoco.MjData(self.model)
        self.frame_skip = frame_skip
        self.pos_tol = pos_tol
        self.yaw_tol = yaw_tol
        self.action_low = np.array(action_low, dtype=np.float64)
        self.action_high = np.array(action_high, dtype=np.float64)

        # ---- 缓存 id / 地址 ----
        m = self.model
        self.block_body = m.body("block").id
        self.target_body = m.body("target").id
        self.block_jnt = m.joint("block_free").id
        self.block_qadr = m.jnt_qposadr[self.block_jnt]
        self.block_dadr = m.jnt_dofadr[self.block_jnt]

        self.right_ctrl_ids = np.array(
            [m.actuator(f"right_joint{i}_ctrl").id for i in range(1, 8)])
        self.right_finger_ctrl = m.actuator("right_finger1_ctrl").id
        self.left_ctrl_ids = np.array(
            [m.actuator(f"left_joint{i}_ctrl").id for i in range(1, 8)])
        self.left_finger_ctrl = m.actuator("left_finger1_ctrl").id

        self.right_qadr = np.array(
            [m.jnt_qposadr[m.joint(f"openarm_right_joint{i}").id]
             for i in range(1, 8)])
        self.left_qadr = np.array(
            [m.jnt_qposadr[m.joint(f"openarm_left_joint{i}").id]
             for i in range(1, 8)])

        # ---- IK ----
        self.ik = RightArmIK(m, self.data, z_fixed=z_fixed)

        # ---- 初始姿态（用 IK 反解得到，避免手填关节角） ----
        self.block_init_qpos = np.array([0.30, -0.12, 0.06, 1, 0, 0, 0])
        self.left_home = np.array([0.0, 0.3, 0.0, 1.2, 0.0, 0.3, 0.0])
        self.finger_home = 0.0          # 右手指闭合到 0；左手指保持 0
        # 先用一个合理初值做 IK warm-start
        warm = np.array([0.0, 0.5, 0.0, 1.5, 0.0, 0.5, 0.0])
        self.right_home = self.ik.solve((0.30, -0.12), q_init=warm)
        print("[OpenArmPushTEnv] right_home =", np.round(self.right_home, 4))

        self._obs_dim = 3 + 4 + 6 + 3 + 3 + 4   # block pos/quat/vel + ee + target pos/quat
        self._last_q = self.right_home.copy()   # IK warm-start 缓存

    # ------------------------------------------------------------------
    def reset(self):
        mujoco.mj_resetData(self.model, self.data)
        d = self.data

        # 右臂 / 左臂 / 手指
        d.qpos[self.right_qadr] = self.right_home
        d.qpos[self.left_qadr] = self.left_home
        d.qpos[self.block_qadr:self.block_qadr + 7] = self.block_init_qpos

        d.ctrl[:] = 0.0
        d.ctrl[self.right_ctrl_ids] = self.right_home
        d.ctrl[self.left_ctrl_ids] = self.left_home
        d.ctrl[self.right_finger_ctrl] = self.finger_home
        d.ctrl[self.left_finger_ctrl] = self.finger_home

        self._last_q = self.right_home.copy()
        mujoco.mj_forward(self.model, self.data)
        return self._get_obs()

    # ------------------------------------------------------------------
    def step(self, action):
        action = np.asarray(action, dtype=np.float64).reshape(2)
        action = np.clip(action, self.action_low, self.action_high)

        # 1) IK: (x,y) -> 7 关节角（用上一步解 warm-start）
        q_target = self.ik.solve(action, q_init=self._last_q)
        self._last_q = q_target

        # 2) 写控制
        d = self.data
        d.ctrl[self.right_ctrl_ids] = q_target
        d.ctrl[self.left_ctrl_ids] = self.left_home
        d.ctrl[self.right_finger_ctrl] = self.finger_home
        d.ctrl[self.left_finger_ctrl] = self.finger_home

        # 3) 推进仿真
        for _ in range(self.frame_skip):
            mujoco.mj_step(self.model, self.data)

        obs = self._get_obs()
        reward = self._get_reward()
        success = self._is_success()
        info = {"success": success,
                "pos_err": self._pos_err(),
                "yaw_err": self._yaw_err()}
        return obs, reward, success, info

    # ------------------------------------------------------------------
    def _get_obs(self):
        d = self.data
        block_pos = d.xpos[self.block_body].copy()
        block_quat = d.xquat[self.block_body].copy()
        block_vel = d.qvel[self.block_dadr:self.block_dadr + 6].copy()
        ee_pos = d.site_xpos[self.ik.site_id].copy()
        target_pos = d.xpos[self.target_body].copy()
        target_quat = d.xquat[self.target_body].copy()
        return np.concatenate(
            [block_pos, block_quat, block_vel,
             ee_pos, target_pos, target_quat]).astype(np.float32)

    # ------------------------------------------------------------------
    @staticmethod
    def _yaw_from_quat(q):
        w, x, y, z = q
        return np.arctan2(2 * (w * z + x * y), 1 - 2 * (y * y + z * z))

    def _pos_err(self):
        return float(np.linalg.norm(
            self.data.xpos[self.block_body][:2] -
            self.data.xpos[self.target_body][:2]))

    def _yaw_err(self):
        by = self._yaw_from_quat(self.data.xquat[self.block_body])
        ty = self._yaw_from_quat(self.data.xquat[self.target_body])
        return float(abs((by - ty + np.pi) % (2 * np.pi) - np.pi))

    def _is_success(self):
        return self._pos_err() < self.pos_tol and self._yaw_err() < self.yaw_tol

    def _get_reward(self):
        # 简单负误差奖励；可换成稀疏 + 密集组合
        return -(self._pos_err() + 0.5 * self._yaw_err())

    # ------------------------------------------------------------------
    @property
    def obs_dim(self):
        return self._obs_dim

    @property
    def action_dim(self):
        return 2


# ----------------------------------------------------------------------
# 自测
# ----------------------------------------------------------------------
if __name__ == "__main__":
    xml = os.path.join(os.path.dirname(__file__), "openarm_pusht.xml")
    env = OpenArmPushTEnv(xml)
    obs = env.reset()
    print("obs shape:", obs.shape)
    for t in range(50):
        # 简单示例：把末端从初始点缓慢移向目标区
        alpha = t / 50.0
        xy = (1 - alpha) * np.array([0.30, -0.12]) + alpha * np.array([0.38, -0.20])
        obs, r, done, info = env.step(xy)
        if done:
            print(f"success at step {t}, info={info}")
            break
    print("final info:", info)
