<mujoco model="openarm_bimanual_push_t_scene">
  <!-- 引入原本的双臂模型 -->
  <include file="openarm_bimanual.xml"/>

  <statistic center="0.35 0 0.25" extent="0.8" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-15"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- 天空盒与地面纹理 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <!-- 任务专属材质 -->
    <material name="table_mat" rgba="0.88 0.88 0.88 1.0" specular="0.1" shininess="0.2"/>
    <material name="tee_mat" rgba="0.2 0.45 0.9 1.0" specular="0.3" shininess="0.5"/>       <!-- T块: 蓝色实体 -->
    <material name="goal_mat" rgba="0.2 0.9 0.3 0.3" specular="0.0" shininess="0.0"/>      <!-- 目标区: 绿色半透明 -->
  </asset>

  <worldbody>
    <!-- 光照 -->
    <light pos="0.3 0 1.6" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ==================== 工作台 ==================== -->
    <!-- 桌面中心 x=0.42, 表面高度恰好位于 z = 0.18 (0.09 + 0.09) -->
    <body name="table" pos="0.42 0 0.09">
      <geom name="table_top" type="box" size="0.25 0.38 0.09" material="table_mat" friction="0.8 0.005 0.0001"/>
    </body>

    <!-- ==================== 目标区域 (Goal Zone - 静态虚影) ==================== -->
    <!-- contype="0" conaffinity="0" 确保不产生任何物理碰撞阻碍 -->
    <body name="goal_zone" pos="0.42 0 0.181">
      <!-- 横梁 -->
      <geom name="goal_head" type="box" size="0.08 0.025 0.001" pos="0 0.04 0" 
            material="goal_mat" contype="0" conaffinity="0"/>
      <!-- 竖梁 -->
      <geom name="goal_stem" type="box" size="0.025 0.04 0.001" pos="0 -0.025 0" 
            material="goal_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- ==================== 可被推动的 3D T 型块 ==================== -->
    <!-- 初始高度设定在桌面顶部稍微偏上 0.015m，受重力平稳落于桌面上 -->
    <body name="tee_block" pos="0.38 -0.05 0.195">
      <freejoint name="tee_freejoint"/>
      <!-- T块由两部分组合而成，整体高 0.03m (半高 0.015m) -->
      <!-- 横梁 (Head) -->
      <geom name="tee_head" type="box" size="0.08 0.025 0.015" pos="0 0.04 0" 
            material="tee_mat" mass="0.08" friction="0.6 0.01 0.005" solref="0.01 1" solimp="0.9 0.95 0.001"/>
      <!-- 竖梁 (Stem) -->
      <geom name="tee_stem" type="box" size="0.025 0.04 0.015" pos="0 -0.025 0" 
            material="tee_mat" mass="0.06" friction="0.6 0.01 0.005" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    </body>

    <!-- ==================== 摄像头配置 (Diffusion Policy 视觉输入) ==================== -->
    <!-- 1. 正上方俯视相机 (Push-T 经典输入视角) -->
    <camera name="top_cam" pos="0.42 0 0.85" euler="0 0 1.5708" fovy="55"/>

    <!-- 2. 第三人称斜向正视角 (覆盖机械臂全身和桌面操作区) -->
    <camera name="front_cam" pos="0.95 0 0.62" euler="0 0.65 1.5708" fovy="48"/>

    <!-- 3. 双臂后上方跟随视角 (观察末端对齐细节) -->
    <camera name="shoulder_cam" pos="-0.25 0 0.6" euler="0 0.85 -1.5708" fovy="55"/>
  </worldbody>
</mujoco>
