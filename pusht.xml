<?xml version="1.0" encoding="utf-8"?>

<mujoco model="pusht">

    <!-- 仿真参数 -->
    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="Euler"/>

    <!-- 全局默认参数 -->
    <default>
        <geom
            contype="1"
            conaffinity="1"
            friction="1.0 0.1 0.1"
            solref="0.01 1"
            solimp="0.9 0.95 0.001"/>

        <joint
            damping="0.1"
            armature="0.001"/>
    </default>

    <!-- 材质 -->
    <asset>
        <material
            name="table_material"
            rgba="0.75 0.75 0.75 1"/>

        <material
            name="block_material"
            rgba="0.20 0.25 0.35 1"/>

        <material
            name="pusher_material"
            rgba="0.05 0.25 0.90 1"/>

        <material
            name="target_material"
            rgba="0.10 0.80 0.20 0.45"/>
    </asset>

    <worldbody>

        <!-- 顶部光源 -->
        <light
            name="top_light"
            pos="0 0 1.5"
            dir="0 0 -1"
            diffuse="1 1 1"/>

        <!-- 桌面 -->
        <geom
            name="table"
            type="box"
            pos="0 0 -0.025"
            size="0.5 0.5 0.025"
            material="table_material"/>

        <!-- 四周墙壁 -->
        <geom
            name="wall_left"
            type="box"
            pos="-0.48 0 0.04"
            size="0.02 0.50 0.04"/>

        <geom
            name="wall_right"
            type="box"
            pos="0.48 0 0.04"
            size="0.02 0.50 0.04"/>

        <geom
            name="wall_bottom"
            type="box"
            pos="0 -0.48 0.04"
            size="0.50 0.02 0.04"/>

        <geom
            name="wall_top"
            type="box"
            pos="0 0.48 0.04"
            size="0.50 0.02 0.04"/>

        <!-- 蓝色推动器 -->
        <!-- mocap body 不需要 joint，可以直接通过 Python 控制位置 -->
        <body
            name="pusher"
            mocap="true"
            pos="0 0.30 0.055">

            <geom
                name="pusher_geom"
                type="cylinder"
                size="0.035 0.025"
                material="pusher_material"/>
        </body>

        <!-- 动态 T 形物体 -->
        <body
            name="block"
            pos="0 0 0.06">

            <!-- freejoint 允许物体在平面内平移和旋转 -->
            <freejoint name="block_free"/>

            <!-- T 的横梁 -->
            <geom
                name="t_bar"
                type="box"
                pos="0 0.08 0"
                size="0.16 0.04 0.035"
                mass="0.20"
                material="block_material"/>

            <!-- T 的竖梁 -->
            <geom
                name="t_stem"
                type="box"
                pos="0 -0.04 0"
                size="0.04 0.12 0.035"
                mass="0.20"
                material="block_material"/>
        </body>

        <!-- 绿色目标区域 -->
        <!-- contype=0 和 conaffinity=0 表示不参与碰撞 -->
        <body
            name="target"
            pos="0.20 0.15 0.005"
            euler="0 0 0.7854">

            <geom
                name="target_bar"
                type="box"
                pos="0 0.08 0"
                size="0.16 0.04 0.002"
                material="target_material"
                contype="0"
                conaffinity="0"/>

            <geom
                name="target_stem"
                type="box"
                pos="0 -0.04 0"
                size="0.04 0.12 0.002"
                material="target_material"
                contype="0"
                conaffinity="0"/>
        </body>

        <!-- 顶视角相机 -->
        <camera
            name="top"
            pos="0 0 1.2"
            xyaxes="1 0 0 0 1 0"
            mode="fixed"/>

    </worldbody>

</mujoco>